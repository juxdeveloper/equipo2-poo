digraph Flujo {
  rankdir=TB;
  node [fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10];
  a [label="Inicio", shape=box, style="rounded,filled", fillcolor="#FFE6CC", color="#D79B00", fontsize=11, fontname="DejaVu Sans"];
  b [label="Recibir mes dia anio", shape=parallelogram, style=filled, fillcolor="#D5E8D4", color="#82B366", fontsize=11, fontname="DejaVu Sans"];
  c [label="Asignar campos", shape=box, style=filled, fillcolor="#DAE8FC", color="#6C8EBF", fontsize=11, fontname="DejaVu Sans"];
  d [label="Mostrar fecha", shape=parallelogram, style=filled, fillcolor="#F8CECC", color="#B85450", fontsize=11, fontname="DejaVu Sans"];
  e [label="Fin", shape=box, style="rounded,filled", fillcolor="#FFE6CC", color="#D79B00", fontsize=11, fontname="DejaVu Sans"];
  a -> b;
  b -> c;
  c -> d;
  d -> e;
}
