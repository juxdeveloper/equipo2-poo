digraph UML {
  rankdir=TB;
  node [shape=plaintext, fontsize=11, fontname="DejaVu Sans"];
  Division [label=<
    <TABLE BGCOLOR="white" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6">
      <TR><TD ALIGN="CENTER"><B>Division</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>sin atributos</I></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Division()<BR/><U>+ main(args : String[]) : void</U></TD></TR>
    </TABLE>
  >];
}
