      <TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Enfermero(nombre : String, cedula : int, especialidad : int)<BR/>+ registroEnSistema(s : Sistema) : void<BR/>+ verListaPacientes() : void<BR/>+ darTratamiento(paciente : Paciente, tratamiento : String) : boolean<BR/>+ puedeAtender(especialidad : int) : boolean<BR/>+ getNombre() : String<BR/>+ getCedula() : int<BR/>+ getEspecialidad() : int<BR/>+ getNoPacientes() : int</TD></TR>
