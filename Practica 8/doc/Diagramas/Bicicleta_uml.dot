digraph UML {
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=18];
  Bicicleta [label=<
    <TABLE BGCOLOR="white" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
      <TR><TD ALIGN="CENTER"><B>Bicicleta</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT">- tipo : String<BR/>- kilometrosRecorridos : double<BR/>- factorEmisionOperativa : double</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Bicicleta(tipo : String, kilometrosRecorridos : double)<BR/>+ getTipo() : String<BR/>+ getKilometrosRecorridos() : double<BR/>+ getFactorEmisionOperativa() : double<BR/>+ getHuellaCarbono() : double<BR/>+ toString() : String</TD></TR>
    </TABLE>
  >];
}
