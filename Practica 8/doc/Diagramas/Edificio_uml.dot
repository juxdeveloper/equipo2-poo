digraph UML {
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=18];
  Edificio [label=<
    <TABLE BGCOLOR="white" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
      <TR><TD ALIGN="CENTER"><B>Edificio</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre : String<BR/>- consumoAnualKwh : double<BR/>- factorElectricidad : double</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Edificio(nombre : String, consumoAnualKwh : double, factorElectricidad : double)<BR/>+ getNombre() : String<BR/>+ getConsumoAnualKwh() : double<BR/>+ getFactorElectricidad() : double<BR/>+ getHuellaCarbono() : double<BR/>+ toString() : String</TD></TR>
    </TABLE>
  >];
}
