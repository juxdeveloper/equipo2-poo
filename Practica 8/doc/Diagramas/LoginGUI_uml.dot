digraph UML {
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=18];
  LoginGUI [label=<
    <TABLE BGCOLOR="white" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
      <TR><TD ALIGN="CENTER"><B>LoginGUI</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT">- <U>serialVersionUID : long</U> {readOnly}<BR/>- campoUsuario : JTextField<BR/>- campoContrasena : JPasswordField<BR/>- botonIngresar : JButton<BR/>- mensaje : JLabel</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT">+ LoginGUI()<BR/>- configurarVentana() : void<BR/>- crearPanelFormulario() : JPanel<BR/>+ actionPerformed(evento : ActionEvent) : void<BR/>- validarAcceso() : boolean<BR/>+ <U>main(args : String[]) : void</U></TD></TR>
    </TABLE>
  >];
}
