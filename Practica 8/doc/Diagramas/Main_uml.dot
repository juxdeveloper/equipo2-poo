digraph UML {
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=18];
  Main [label=<
    <TABLE BGCOLOR="white" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
      <TR><TD ALIGN="CENTER"><B>Main</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Main()<BR/>+ <U>main(args : String[]) : void</U></TD></TR>
    </TABLE>
  >];
}
