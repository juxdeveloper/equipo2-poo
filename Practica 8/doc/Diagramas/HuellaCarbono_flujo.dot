digraph Flujo {
  rankdir=TB;
  node [fontname="DejaVu Sans", fontsize=18];
  edge [fontname="DejaVu Sans", fontsize=15];
  inicio [label="Inicio getHuellaCarbono()", shape=box, style="rounded,filled", fillcolor="#FFE6CC", color="#D79B00"];
  contrato [label="Solicitar una huella en kg CO2e", shape=box, style=filled, fillcolor="#DAE8FC", color="#6C8EBF"];
  resultado [label="La clase concreta calcula su resultado", shape=parallelogram, style=filled, fillcolor="#F8CECC", color="#B85450"];
  fin [label="Fin", shape=box, style="rounded,filled", fillcolor="#FFE6CC", color="#D79B00"];
  inicio -> contrato -> resultado -> fin;
}
