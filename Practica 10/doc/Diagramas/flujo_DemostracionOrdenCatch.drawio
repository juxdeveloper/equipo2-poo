    <!-- Conexiones ortogonales -->
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;curved=0;strokeColor=#263445;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n1" target="n2">
      <mxGeometry relative="1" as="geometry" />
