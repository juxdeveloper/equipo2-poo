    <!-- 8. Fin -->
    <mxCell id="n8" value="Fin main" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Liberation Sans;fontColor=#263445;fontSize=16;fontStyle=1;strokeWidth=2;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
      <mxGeometry x="260" y="695" width="200" height="50" as="geometry" />
