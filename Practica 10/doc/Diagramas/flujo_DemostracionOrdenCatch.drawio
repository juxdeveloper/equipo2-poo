<mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="title" value="Diagrama de Flujo — DemostracionOrdenCatch.main" style="html=1;fontFamily=Liberation Sans;fontColor=#263445;fontSize=22;fontStyle=1;strokeWidth=2;rounded=0;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
    </mxCell>

    <!-- 1. Inicio -->
    <mxCell id="n1" value="Inicio: main(args)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Liberation Sans;fontColor=#263445;fontSize=16;fontStyle=1;strokeWidth=2;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
      <mxGeometry x="240" y="80" width="240" height="50" as="geometry" />
    </mxCell>

    <!-- 2. Entrada datos consola -->
    <mxCell id="n2" value="Leer tamano, indice y textoValor desde consola" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fontFamily=Liberation Sans;fontColor=#263445;fontSize=16;strokeWidth=2;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
      <mxGeometry x="150" y="160" width="420" height="60" as="geometry" />
    </mxCell>

    <!-- 3. Instanciación demo -->
    <mxCell id="n3" value="demo = new DemostracionOrdenCatch(3)" style="whiteSpace=wrap;html=1;rounded=0;fontFamily=Liberation Sans;fontColor=#263445;fontSize=16;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
      <mxGeometry x="160" y="250" width="400" height="55" as="geometry" />
    </mxCell>

    <!-- 4. Invocación caso usuario -->
    <mxCell id="n4" value="resultado = demo.ejecutarCaso(tamano, indice, textoValor)" style="whiteSpace=wrap;html=1;rounded=0;fontFamily=Liberation Sans;fontColor=#263445;fontSize=16;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
      <mxGeometry x="130" y="335" width="460" height="55" as="geometry" />
    </mxCell>

    <!-- 5. Impresión caso usuario -->
    <mxCell id="n5" value="Imprimir encabezado y resultado del caso ingresado" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fontFamily=Liberation Sans;fontColor=#263445;fontSize=16;strokeWidth=2;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
      <mxGeometry x="140" y="420" width="440" height="60" as="geometry" />
    </mxCell>

    <!-- 6. Invocación e impresión 4 casos predefinidos -->
    <mxCell id="n6" value="Ejecutar e imprimir batería de 4 casos predefinidos (índice fuera de rango, tamaño negativo, formato inválido, arreglo nulo)" style="whiteSpace=wrap;html=1;rounded=0;fontFamily=Liberation Sans;fontColor=#263445;fontSize=15;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
      <mxGeometry x="100" y="510" width="520" height="75" as="geometry" />
    </mxCell>

    <!-- 7. Cerrar Scanner -->
    <mxCell id="n7" value="scanner.close()" style="whiteSpace=wrap;html=1;rounded=0;fontFamily=Liberation Sans;fontColor=#263445;fontSize=16;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
