digraph Flujo {
  rankdir=TB;
  node [fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10];
  
  a [label="Inicio calcularArea()", shape=box, style="rounded,filled", fillcolor="#FFE6CC", color="#D79B00"];
  b [label="lado = getLado()", shape=box, style=filled, fillcolor="#DAE8FC", color="#6C8EBF"];
  c [label="area = lado * lado", shape=box, style=filled, fillcolor="#DAE8FC", color="#6C8EBF"];
  d [label="Retornar area", shape=parallelogram, style=filled, fillcolor="#F8CECC", color="#B85450"];
  e [label="Fin", shape=box, style="rounded,filled", fillcolor="#FFE6CC", color="#D79B00"];
  
  a -> b;
  b -> c;
  c -> d;
  d -> e;
}
