digraph Flujo {
  rankdir=TB;
  node [fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10];
  
  a [label="Inicio", shape=box, style="rounded,filled", fillcolor="#FFE6CC", color="#D79B00"];
  b [label="Recibir coordenadas (x, y)", shape=parallelogram, style=filled, fillcolor="#D5E8D4", color="#82B366"];
  c [label="this.x = x", shape=box, style=filled, fillcolor="#DAE8FC", color="#6C8EBF"];
  d [label="this.y = y", shape=box, style=filled, fillcolor="#DAE8FC", color="#6C8EBF"];
  e [label="Fin", shape=box, style="rounded,filled", fillcolor="#FFE6CC", color="#D79B00"];
  
  a -> b;
  b -> c;
  c -> d;
  d -> e;
}
